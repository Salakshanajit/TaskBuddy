# Copy this file to ".env" (same folder) and fill in your own values.
PORT=5000

# Local MongoDB:
#   mongodb://127.0.0.1:27017/taskbuddy
# MongoDB Atlas (free tier):
#   mongodb+srv://<username>:<password>@<cluster>.mongodb.net/taskbuddy?retryWrites=true&w=majority
MONGO_URI=your_mongodb_connection_string

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_secret_key
JWT_EXPIRES_IN=7d

# Origin of the React app (used for CORS). Comma-separate to allow several.
CLIENT_URL=http://localhost:5173
